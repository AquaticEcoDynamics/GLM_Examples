!-------------------------------------------------------------------------------

!-------------------------------------------------------------------------------
! general model setup
!-------------------------------------------------------------------------------
&glm_setup
   sim_name = 'Example Inverted Cone GLM Simulation'
   max_layers = 500
   min_layer_vol = 0.025
   min_layer_thick = 0.15
   max_layer_thick = 1.50
   density_model = 1
/

!-------------------------------------------------------------------------------
&wq_setup
!-- Choose 'aed' or 'api' (aed is the default)
   wq_lib = 'api'
   wq_nml_file = 'aed.nml'
   ode_method = 1
   split_factor = 1
   bioshade_feedback = .true.
!  repair_state = .true.
!  mobility_off = .true.
/

!-------------------------------------------------------------------------------
! mixing
!-------------------------------------------------------------------------------
&mixing
  surface_mixing = 1
  coef_mix_conv  = 0.125
  coef_wind_stir = 0.23
  coef_mix_shear = 0.2
  coef_mix_turb  = 0.51
  coef_mix_KH    = 0.3
  deep_mixing    = 2
  coef_mix_hyp   = 0.5
  diff = 0.
/

!-------------------------------------------------------------------------------
! morphometry
!-------------------------------------------------------------------------------
&morphometry
   lake_name  = 'Cone'
   latitude   =    32.0
   longitude  =    35.0
   crest_elev =   100.0
!  base_elev  =    32.0
   bsn_len    =   200.0
   bsn_wid    =   200.0
   bsn_vals   =      2
   H =   10.0,    100.0
   A = 314.16, 314159.0
/

!-------------------------------------------------------------------------------
! duration of run
!-------------------------------------------------------------------------------
&time
   timefmt  = 3                       ! Choose 2 (start/stop) or 3 (num_days)
   start    = '2018-01-01 00:00:00'
   stop     = '2020-12-01 00:00:00'
   dt       = 3600.0
   num_days = 730
/

!-------------------------------------------------------------------------------
! format for output and filename(s)
!-------------------------------------------------------------------------------
&output
   out_dir = 'output'
   out_fn  = 'output'
   nsave = 6
   ! General summary file
   csv_lake_fname = 'lake'
   ! Depth specific outputs
   csv_point_nlevs = 1
   csv_point_fname = 'WQ_'
   csv_point_at = 5.
   csv_point_nvars = 2
   csv_point_vars = 'temp','salt'
   ! Combined outlet file & overflow
/

!-------------------------------------------------------------------------------
! initial condition profiles
!-------------------------------------------------------------------------------
&init_profiles
    lake_depth = 80.0
    num_depths = 5
    the_depths =  1.0, 20.0, 40.0, 60.0, 80.0
    the_temps  = 18.0, 18.0, 18.0, 18.0, 18.0
    the_sals   =  0.5,  0.5,  0.5,  0.5,  0.5
/

!-------------------------------------------------------------------------------
! meteorology
!-------------------------------------------------------------------------------
&meteorology
   met_sw      = .false.
   lw_type     = 'LW_IN'
   rain_sw     = .false.
   atm_stab    = 0
   fetch_mode  = 0
  !rad_mode    = 1
   albedo_mode = 1
   cloud_mode  = 4
   !-- BC file details
   subdaily    = .true.
   meteo_fl    = 'met_hourly.csv'
   wind_factor = 0.9
   lw_factor   = 1.0
   lw_offset   = 0.0
   !-- Parameters
   ce = 0.0013
   ch = 0.0013
   cd  = 0.0013
  !catchrain      = .true.
  !rain_threshold = 0.001
  !runoff_coef    = 0.0
/

!-------------------------------------------------------------------------------
! light
!-------------------------------------------------------------------------------
&light
   light_mode = 0
   n_bands = 4
   light_extc = 1.0, 0.5, 2.0, 4.0
   energy_frac = 0.51, 0.45, 0.035, 0.005
   Benthic_Imin = 10
   Kw = 0.57
  !albedo_mean = 0.08
  !albedo_amplitude = 0.02
/

!-------------------------------------------------------------------------------
! bird_model
!-------------------------------------------------------------------------------
&bird_model
  AP = 973
  Oz = 0.279
  WatVap = 1.1
  AOD500 = 0.033
  AOD380 = 0.038
  Albedo = 0.2
/

!-------------------------------------------------------------------------------
! sediment zones & properties
!-------------------------------------------------------------------------------
&sediment
  sed_heat_Ksoil     = 0.0
  sed_temp_depth     = 0.2
  benthic_mode       = 2
  n_zones            = 4
  zone_heights       = 22.5, 45.0, 67.5, 90.0
! sed_temp_mean      =  5, 10, 20
! sed_temp_amplitude =  6,  8, 10
! sed_temp_peak_doy  = 80, 70, 60
! sed_reflectivity   = 0.1,0.01,0.01
! sed_roughness      = 0.1,0.01,0.01
/

!-------------------------------------------------------------------------------
! ice & snow
!-------------------------------------------------------------------------------
&snowice
   snow_albedo_factor = 1.0
   snow_rho_max       = 300
   snow_rho_min       = 50
/
